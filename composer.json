{
    "name": "weldist/spatie-medialibrary-webp-downloader",
    "description": "Drop-in Downloader for spatie/laravel-medialibrary that converts every fetched image to WebP on the fly.",
    "keywords": ["laravel", "spatie", "medialibrary", "webp", "downloader", "image"],
    "license": "MIT",
    "authors": [
        {
            "name": "X-Adam",
            "email": "www@mehmetogmen.com.tr",
            "homepage": "https://mehmetogmen.com.tr"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "spatie/image": "^3.0",
        "spatie/laravel-medialibrary": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Weldist\\Spatie\\MediaLibrary\\WebpDownloader\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Weldist\\Spatie\\MediaLibrary\\WebpDownloader\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Weldist\\Spatie\\MediaLibrary\\WebpDownloader\\WebpDownloaderServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
